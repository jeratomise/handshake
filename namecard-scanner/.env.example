# Copy to .env.local for local development, and set the same pair in Vercel
# under Settings -> Environment Variables.
#
# Leave both blank to run the app local-only: no sign-in, profile and history
# in localStorage. Everything except cross-device sync works that way.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The publishable ("anon") key. This one is meant to be in the client — row
# level security is what protects the data, not the secrecy of this key.
# Never put the service_role key here: it bypasses every policy.
VITE_SUPABASE_ANON_KEY=

# Set to "false" to skip email verification and go straight into the scanner.
# Anything else — including a typo, an empty value, or leaving it unset — keeps
# verification ON, because the dangerous mistake is accidentally shipping an
# open app, not accidentally shipping a closed one.
#
# With verification off there is no signed-in user, so nothing syncs: the
# profile and history stay on the device.
VITE_REQUIRE_EMAIL_VERIFICATION=
